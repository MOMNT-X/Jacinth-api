# Database Configuration
# IMPORTANT: For Supabase, you MUST use connection pooling with connection_limit=1
# This prevents connection pool exhaustion errors (P2024, P1008)

# For Supabase (Production/Development):
# Use connection pooler URL with pgbouncer for DATABASE_URL
# The connection_limit=1 parameter is CRITICAL to prevent pool exhaustion
DATABASE_URL=postgresql://postgres:PASSWORD@HOST.pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=1
# Use direct connection URL (without pgbouncer) for DIRECT_URL
# This is used for migrations and schema operations
DIRECT_URL=postgresql://postgres:PASSWORD@HOST.pooler.supabase.com:5432/postgres

# For local PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/jacinth_db
# DIRECT_URL=postgresql://user:password@localhost:5432/jacinth_db

# Application Configuration
PORT=3001
NODE_ENV=development
APP_NAME=Jacinth Pharmacy
APP_EMAIL=noreply@jacinthpharmacy.com

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# SendGrid Email Service
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@jacinthpharmacy.com

# Twilio SMS Service
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Payment Providers
PAYSTACK_SECRET_KEY=your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=your-paystack-public-key
FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key
FLUTTERWAVE_PUBLIC_KEY=your-flutterwave-public-key

# Discord Notifications
DISCORD_WEBHOOK_URL=your-discord-webhook-url

